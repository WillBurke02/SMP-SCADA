<Window
    x:Class="SMP_SCADA.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:SMP_SCADA.Views"
    xmlns:vm="clr-namespace:SMP_SCADA.ViewModels"
    Title="SMP SCADA"
    Width="1920"
    Height="1080"
    Background="{StaticResource BackgroundBrush}"
    FontFamily="Bahnschrift, Segoe UI"
    FontSize="16"
    Foreground="{StaticResource ValueBrush}"
    WindowState="Maximized">

    <Window.InputBindings>
        <KeyBinding
            Key="F1"
            Command="{Binding ShowPage}"
            CommandParameter="{x:Static vm:PageId.Overview}" />
        <KeyBinding
            Key="F2"
            Command="{Binding ShowPage}"
            CommandParameter="{x:Static vm:PageId.Drive}" />
        <KeyBinding
            Key="F3"
            Command="{Binding ShowPage}"
            CommandParameter="{x:Static vm:PageId.Alarms}" />
        <KeyBinding
            Key="F4"
            Command="{Binding ShowPage}"
            CommandParameter="{x:Static vm:PageId.Engineer}" />
    </Window.InputBindings>

    <!--  Which view draws each page's view model.  -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EngineerViewModel}">
            <views:EngineerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriveViewModel}">
            <views:DriveView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EventsViewModel}">
            <views:EventsView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!--  Header  -->
        <Border
            MinHeight="56"
            Padding="24,8"
            Background="{StaticResource HeaderBrush}"
            BorderBrush="{StaticResource HeaderLineBrush}"
            BorderThickness="0,0,0,3"
            DockPanel.Dock="Top"
            TextElement.Foreground="White">
            <DockPanel>
                <TextBlock
                    Width="172"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="SMP SCADA" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Access" />
                        <TextBlock Text="{Binding AccessText}" />
                    </StackPanel>
                    <StackPanel MinWidth="84" Margin="28,0,0,0">
                        <TextBlock Style="{StaticResource HeaderLabel}" Text="{Binding DateText}" />
                        <TextBlock Text="{Binding TimeText}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Bar" />
                        <TextBlock Text="{Binding BarText}" />
                    </StackPanel>
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Drive link" />
                        <TextBlock Text="{Binding LinkText}" />
                    </StackPanel>
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Data" />
                        <TextBlock Text="{Binding DataText}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Only when the service runs the simulator  -->
        <Border
            Padding="24,8"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource ValueBrush}"
            BorderThickness="0,0,0,2"
            DockPanel.Dock="Top"
            Visibility="{Binding IsSimulated, Converter={StaticResource Visible}}">
            <TextBlock
                Padding="8,2"
                HorizontalAlignment="Left"
                Background="{StaticResource ValueBrush}"
                FontWeight="SemiBold"
                Foreground="White"
                Text="SIMULATED" />
        </Border>

        <!--  Alarm banner  -->
        <Border
            Height="164"
            Background="{StaticResource BannerBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <DockPanel>
                <Border
                    Width="220"
                    Padding="20,12"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,1,0"
                    DockPanel.Dock="Left">
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Top"
                            Style="{StaticResource Caption}"
                            Text="Alarms" />
                        <TextBlock
                            Margin="0,6,0,0"
                            DockPanel.Dock="Top"
                            FontWeight="SemiBold"
                            Text="{Binding AlarmSummary}" />
                        <Button
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Command="{Binding Acknowledge}"
                            Content="Acknowledge all"
                            Style="{StaticResource PrimaryButton}" />
                    </DockPanel>
                </Border>
                <ScrollViewer Padding="24,8" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AlarmRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Height="32"
                                    BorderBrush="{StaticResource RowLineBrush}"
                                    BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40">
                                            <Grid
                                                Width="26"
                                                Height="24"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding SymbolShown, Converter={StaticResource Visible}}">
                                                <Path Style="{StaticResource AlarmSymbol}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Text="{Binding Number}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock
                                            Width="90"
                                            VerticalAlignment="Center"
                                            Text="{Binding Time}" />
                                        <TextBlock
                                            Width="600"
                                            VerticalAlignment="Center"
                                            Text="{Binding Text}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding State}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--  Side menu  -->
        <Border
            Width="220"
            Padding="0,12"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,1,0"
            DockPanel.Dock="Left">
            <DockPanel>
                <StackPanel Margin="20,16,20,4" DockPanel.Dock="Bottom">
                    <TextBlock Style="{StaticResource Caption}" Text="Service" />
                    <TextBlock Text="{Binding ServiceText}" TextWrapping="Wrap" />
                    <Button
                        Margin="0,12,0,0"
                        Command="{Binding Restart}"
                        Content="Restart" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Menu}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Command="{Binding DataContext.ShowPage, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Page}"
                                Style="{StaticResource MenuButton}">
                                <DockPanel>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        FontWeight="Normal"
                                        Opacity="0.75"
                                        Text="{Binding Key}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="Normal"
                                            Opacity="0.75"
                                            Text="Engineer"
                                            Visibility="{Binding EngineerOnly, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!--  The page  -->
        <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
</Window>