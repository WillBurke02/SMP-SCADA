<UserControl
    x:Class="SMP_SCADA.Views.EngineerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SMP_SCADA.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <!--  Asked for every time the page opens  -->
        <StackPanel
            Margin="40,20"
            HorizontalAlignment="Left"
            Visibility="{Binding IsLocked, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource PanelHeading}" Text="Engineer PIN" />
            <StackPanel Orientation="Horizontal">
                <PasswordBox
                    x:Name="Pin"
                    Width="160"
                    Height="40"
                    VerticalContentAlignment="Center"
                    Background="{StaticResource InputBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    FontSize="18"
                    KeyDown="PinKeyDown" />
                <Button
                    Margin="10,0,0,0"
                    Click="UnlockClick"
                    Content="Unlock"
                    Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <TextBlock
                Margin="0,6,0,0"
                FontWeight="SemiBold"
                Text="{Binding PinError}" />
        </StackPanel>
        <StackPanel
            Width="1000"
            Margin="40,20"
            HorizontalAlignment="Left"
            Visibility="{Binding IsUnlocked, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource PanelHeading}" Text="Drive link" />
            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Style="{StaticResource Caption}"
                    Text="Network adapter" />
                <ComboBox
                    Width="460"
                    Height="40"
                    VerticalContentAlignment="Center"
                    DisplayMemberPath="Description"
                    ItemsSource="{Binding NetworkAdapters}"
                    SelectedValue="{Binding AdapterInput}"
                    SelectedValuePath="Name" />
                <Button
                    Margin="10,0,0,0"
                    Command="{Binding UseAdapter}"
                    Content="Use" />
            </StackPanel>
            <CheckBox
                VerticalContentAlignment="Center"
                Content="Machine safe to stop"
                IsChecked="{Binding SafeToStop}" />
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <Button
                    Command="{Binding ConnectDrive}"
                    Content="Connect"
                    Style="{StaticResource PrimaryButton}" />
                <Button
                    Margin="10,0,0,0"
                    Command="{Binding RestoreEnable}"
                    Content="Restore enable source" />
                <Button
                    Margin="10,0,0,0"
                    Command="{Binding DisconnectDrive}"
                    Content="Disconnect" />
            </StackPanel>
            <TextBlock Margin="0,12,0,0">
                <Run Style="{StaticResource Unit}" Text="Enable source" />
                <Run FontWeight="SemiBold" Text="{Binding EnableLogicText, Mode=OneWay}" />
            </TextBlock>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PanelHeading}" Text="Deadband" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            Width="140"
                            Text="{Binding DeadbandInput, UpdateSourceTrigger=PropertyChanged}"
                            TextAlignment="Right" />
                        <TextBlock
                            Margin="8,0,24,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Style="{StaticResource Caption}"
                            Text="counts" />
                        <Button Command="{Binding ApplyDeadband}" Content="Apply" />
                        <TextBlock Margin="24,0,0,0" VerticalAlignment="Center">
                            <Run Style="{StaticResource Unit}" Text="In force" />
                            <Run FontWeight="SemiBold" Text="{Binding DeadbandText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PanelHeading}" Text="Re-measure calibration" />
                    <TextBlock>
                        <Run Style="{StaticResource Unit}" Text="In force" />
                        <Run FontWeight="SemiBold" Text="{Binding CalibrationText, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Command="{Binding Start}" Content="Start" />
                        <TextBlock Margin="24,0,0,0" VerticalAlignment="Center">
                            <Run Style="{StaticResource Unit}" Text="Counts moved" />
                            <Run FontWeight="SemiBold" Text="{Binding CountsMovedText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Style="{StaticResource Caption}"
                            Text="Turns" />
                        <TextBox
                            Width="100"
                            Text="{Binding TurnsInput, UpdateSourceTrigger=PropertyChanged}"
                            TextAlignment="Right" />
                        <TextBlock
                            Margin="24,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Style="{StaticResource Caption}"
                            Text="Bar diameter" />
                        <TextBox
                            Width="140"
                            Text="{Binding DiameterInput, UpdateSourceTrigger=PropertyChanged}"
                            TextAlignment="Right" />
                        <TextBlock
                            Margin="8,0,24,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Style="{StaticResource Caption}"
                            Text="mm" />
                        <Button Command="{Binding Finish}" Content="Finish" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0">
                        <Run Style="{StaticResource Unit}" Text="Proposed" />
                        <Run FontWeight="SemiBold" Text="{Binding ProposedText, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button
                            Command="{Binding Save}"
                            Content="Save"
                            Style="{StaticResource PrimaryButton}" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding Cancel}"
                            Content="Cancel" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PanelHeading}" Text="Manuals and tools" />
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,10,10"
                                    Command="{Binding DataContext.OpenLink, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Target}"
                                    Content="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock
                Margin="0,18,0,0"
                FontWeight="SemiBold"
                Text="{Binding Error}" />
        </StackPanel>
    </Grid>
</UserControl>
