<UserControl
    x:Class="SMP_SCADA.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!--  Right: bar setup, zero and calibration  -->
        <Border
            Width="460"
            Padding="32,20"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1,0,0,0"
            DockPanel.Dock="Right">
            <StackPanel>
                <TextBlock Style="{StaticResource PanelHeading}" Text="Bar setup" />
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,6"
                            Style="{StaticResource Caption}"
                            Text="Diameter" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox
                                Width="140"
                                Text="{Binding DiameterInput, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Right" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Style="{StaticResource Caption}"
                                Text="mm" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="40,0,0,0">
                        <TextBlock
                            Margin="0,0,0,6"
                            Style="{StaticResource Caption}"
                            Text="Circumference" />
                        <TextBlock
                            Height="40"
                            Padding="0,8,0,0"
                            FontSize="18"
                            FontWeight="SemiBold">
                            <Run Text="{Binding CircumferenceText, Mode=OneWay}" />
                            <Run
                                FontSize="16"
                                Style="{StaticResource Unit}"
                                Text="mm" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    Margin="0,6,0,0"
                    FontWeight="SemiBold"
                    Text="{Binding DiameterError}" />
                <Button
                    Margin="0,12,0,0"
                    Command="{Binding ApplyDiameter}"
                    Content="Apply" />

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PanelHeading}" Text="Zero" />
                        <Button Command="{Binding AskZero}" Content="Zero position" />
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding ConfirmingZero, Converter={StaticResource Visible}}">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Zero position?" />
                            <TextBlock Margin="0,4,0,12" Text="Distance, angle and total travel reset to 0." />
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding CancelZero}" Content="Cancel" />
                                <Button
                                    Margin="10,0,0,0"
                                    Command="{Binding ConfirmZero}"
                                    Content="Zero"
                                    Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding ZeroError}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PanelHeading}" Text="Calibration" />
                        <TextBlock
                            FontSize="16"
                            Style="{StaticResource Caption}"
                            Text="Reference" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding CalibrationText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!--  Left: the live values, in priority order  -->
        <StackPanel Margin="40,20">
            <Border
                Padding="0,0,0,24"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Heading}" Text="Bar surface speed" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Style="{StaticResource Caption}"
                            Text="{Binding Direction}" />
                        <Label Style="{StaticResource StaleTag}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource LiveValue}">
                            <Run FontSize="128" Text="{Binding SpeedText, Mode=OneWay}" />
                            <Run
                                FontSize="36"
                                Style="{StaticResource Unit}"
                                Text="mm/s" />
                        </TextBlock>
                        <Border
                            Margin="48,0,0,20"
                            Padding="40,0,0,0"
                            VerticalAlignment="Bottom"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="16"
                                        Style="{StaticResource Caption}"
                                        Text="Rotation speed" />
                                    <TextBlock Style="{StaticResource LiveValue}">
                                        <Run FontSize="56" Text="{Binding RpmText, Mode=OneWay}" />
                                        <Run
                                            FontSize="24"
                                            Style="{StaticResource Unit}"
                                            Text="rpm" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Margin="40,0,0,0">
                                    <TextBlock
                                        FontSize="16"
                                        Style="{StaticResource Caption}"
                                        Text="Rotation frequency" />
                                    <TextBlock Style="{StaticResource LiveValue}">
                                        <Run FontSize="56" Text="{Binding HzText, Mode=OneWay}" />
                                        <Run
                                            FontSize="24"
                                            Style="{StaticResource Unit}"
                                            Text="Hz" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Heading}" Text="Angle" />
                        <Label Style="{StaticResource StaleTag}" />
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <!--  Dial: 0 at the top, clockwise  -->
                        <Grid Width="200" Height="200">
                            <Ellipse
                                Margin="24"
                                Stroke="{StaticResource StaleBrush}"
                                StrokeThickness="2" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Style="{StaticResource Caption}"
                                Text="0" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource Caption}"
                                Text="90" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource Caption}"
                                Text="180" />
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource Caption}"
                                Text="270" />
                            <Line
                                Stroke="{StaticResource LabelBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="4"
                                X1="100"
                                X2="100"
                                Y1="100"
                                Y2="24">
                                <Line.RenderTransform>
                                    <RotateTransform Angle="{Binding AngleDeg}" CenterX="100" CenterY="100" />
                                </Line.RenderTransform>
                            </Line>
                        </Grid>
                        <TextBlock
                            Margin="28,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource LiveValue}">
                            <Run FontSize="88" Text="{Binding AngleText, Mode=OneWay}" /><Run
                                FontSize="36"
                                Style="{StaticResource Unit}"
                                Text="°" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Heading}" Text="Distance from zero" />
                        <Label Style="{StaticResource StaleTag}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource LiveValue}">
                        <Run FontSize="88" Text="{Binding DistanceText, Mode=OneWay}" />
                        <Run
                            FontSize="36"
                            Style="{StaticResource Unit}"
                            Text="mm" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Caption}"
                        Text="{Binding ZeroText}" />

                    <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Heading}" Text="Total travel since zero" />
                        <Label Style="{StaticResource StaleTag}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource LiveValue}">
                        <Run FontSize="56" Text="{Binding TravelText, Mode=OneWay}" />
                        <Run
                            FontSize="28"
                            Style="{StaticResource Unit}"
                            Text="m" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </StackPanel>
    </DockPanel>
</UserControl>