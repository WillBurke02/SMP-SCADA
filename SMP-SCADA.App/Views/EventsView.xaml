<UserControl
    x:Class="SMP_SCADA.Views.EventsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="40" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.ColumnSpan="3"
            Margin="0,0,0,16"
            Orientation="Horizontal">
            <ComboBox
                Width="200"
                Height="40"
                VerticalContentAlignment="Center"
                ItemsSource="{Binding Periods}"
                SelectedItem="{Binding Period}" />
            <Button
                Margin="12,0,0,0"
                Command="{Binding Refresh}"
                Content="Refresh" />
            <TextBlock
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding Error}" />
        </StackPanel>

        <!--  Alarms  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,8"
            Orientation="Horizontal">
            <TextBlock
                Width="150"
                VerticalAlignment="Center"
                Style="{StaticResource Heading}"
                Text="Alarms" />
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="16"
                Style="{StaticResource Caption}"
                Text="Priority" />
            <ComboBox
                Width="140"
                Height="40"
                VerticalContentAlignment="Center"
                ItemsSource="{Binding Priorities}"
                SelectedItem="{Binding PriorityFilter}" />
        </StackPanel>
        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            ItemsSource="{Binding AlarmRows}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Width="26" Height="24">
                                <Path Style="{StaticResource AlarmSymbol}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Text="{Binding Number}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding Time}"
                    Header="Time" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Alarm}"
                    Header="Alarm" />
                <DataGridTextColumn
                    Width="130"
                    Binding="{Binding Change}"
                    Header="Change" />
            </DataGrid.Columns>
        </DataGrid>

        <!--  Information: everything that isn't an alarm  -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="2"
            Margin="0,0,0,8"
            Orientation="Horizontal">
            <TextBlock
                Width="150"
                VerticalAlignment="Center"
                Style="{StaticResource Heading}"
                Text="Information" />
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="16"
                Style="{StaticResource Caption}"
                Text="Kind" />
            <ComboBox
                Width="160"
                Height="40"
                VerticalContentAlignment="Center"
                ItemsSource="{Binding Kinds}"
                SelectedItem="{Binding KindFilter}" />
        </StackPanel>
        <DataGrid
            Grid.Row="2"
            Grid.Column="2"
            AutoGenerateColumns="False"
            ItemsSource="{Binding InfoRows}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding Time}"
                    Header="Time" />
                <DataGridTextColumn
                    Width="110"
                    Binding="{Binding Kind}"
                    Header="Kind" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Text}"
                    Header="Text" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>